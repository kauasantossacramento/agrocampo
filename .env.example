# ---- Django ----
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Banco ----
# sqlite (dev) ou postgres://user:senha@host:5432/agrocampo
DATABASE_URL=sqlite:///db.sqlite3

# ---- Stone (opcional) ----
# As credenciais tambem podem ser cadastradas pelo painel, em
# Pagamentos > Provedores. Estas variaveis servem apenas de fallback
# para o bootstrap inicial do ambiente.
STONE_ENVIRONMENT=sandbox
STONE_CLIENT_ID=
STONE_CLIENT_SECRET=
STONE_API_KEY=
STONE_MERCHANT_ID=
STONE_AFFILIATION_CODE=
STONE_WEBHOOK_SECRET=
STONE_PIX_KEY=

# ---- Avisos automáticos por WhatsApp (opcional) ----
# Segredo compartilhado entre o Django e o serviço `whatsapp` do compose.
# Gere com: openssl rand -hex 32. Vazio = envio automático indisponível.
WHATSAPP_WEB_TOKEN=
# Em desenvolvimento, se rodar o serviço à mão: http://localhost:3000
WHATSAPP_WEB_URL=
# Prefixo dos links enviados nas mensagens (WhatsApp e e-mail)
SITE_URL=http://localhost:8000

# ---- Assistente Silvinha ----
# A chave do Gemini é cadastrada no painel (Configurações › Silvinha),
# não aqui.
